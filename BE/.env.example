PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (password recovery OTP email)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Who's Free <no-reply@your-verified-domain.com>"

# JWT — Dùng chuỗi ngẫu nhiên dài (>= 32 ký tự), KHÔNG được để lộ
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret

# URLs
CLIENT_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000
