PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email: chọn nhà gửi bằng EMAIL_PROVIDER = "resend" (mặc định nếu để trống) hoặc "brevo".
# Dùng cho OTP quên mật khẩu, lời mời, email chốt lịch, email nhắc hạn / phiên đã đóng.
EMAIL_PROVIDER=resend

# Resend (khi EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Who's Free <no-reply@your-verified-domain.com>"

# Brevo (khi EMAIL_PROVIDER=brevo). BREVO_SENDER_EMAIL phải là địa chỉ đã xác minh trong Brevo.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@your-verified-domain.com
BREVO_SENDER_NAME="Who's Free"

# JWT — Dùng chuỗi ngẫu nhiên dài (>= 32 ký tự), KHÔNG được để lộ
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret

# Job nhắc hạn / đóng session (cron gọi POST /api/jobs/session-deadlines kèm header x-job-secret). Để trống = endpoint trả 503.
JOB_SECRET=replace_with_a_long_random_secret

# URLs
CLIENT_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000
